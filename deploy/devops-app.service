[Unit]
Description=DevOps Flask App
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/devops-deploy-project
EnvironmentFile=/etc/devops-app.env
ExecStart=/home/ubuntu/devops-deploy-project/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
